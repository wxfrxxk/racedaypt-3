@model LoginVm
@{
    ViewData["Title"] = "Log in";
}
<div class="rd-auth">
    <div class="rd-auth-art">
        <h1>YOUR NEXT<br />START LINE<br /><span>IS WAITING.</span></h1>
        <p>Find road runs, walks and cycle events across South Africa, enter in seconds and track every finish.</p>
    </div>
    <div class="rd-card rd-auth-card">
        <h2>Log in</h2>
        <partial name="_ValidationSummary" />
        <form asp-action="Login" method="post" novalidate>
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-rd w-100">Log in</button>
        </form>
        <p class="mt-3 mb-0 text-center small">New to RaceDay? <a asp-action="Register">Create a participant account</a></p>
    </div>
</div>
