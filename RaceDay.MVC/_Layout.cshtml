@{
    var role = Context.Session.GetString("Role");
    var fullName = Context.Session.GetString("FullName");
    var loggedIn = Context.Session.GetInt32("UserID") != null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "RaceDay") | RaceDay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg rd-navbar">
        <div class="container">
            <a class="navbar-brand rd-brand" asp-controller="Home" asp-action="Index">
                <span class="rd-brand-mark">&#9889;</span>RACE<span>DAY</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav me-auto">
                    @if (role == "Participant")
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Events</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyEvents">My Events</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyResults">My Results</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Profile">Profile</a></li>
                    }
                    else if (role == "Organiser")
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Events">Manage Events</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="CreateEvent">New Event</a></li>
                    }
                </ul>
                <div class="d-flex align-items-center gap-3">
                    @if (loggedIn)
                    {
                        <span class="rd-user"><span class="rd-role-pill">@role</span> @fullName</span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="btn btn-sm btn-rd-outline">Log out</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-rd-outline" asp-controller="Account" asp-action="Login">Log in</a>
                        <a class="btn btn-sm btn-rd" asp-controller="Account" asp-action="Register">Sign up</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main class="container rd-main">
        @await Html.PartialAsync("_Alerts")
        @RenderBody()
    </main>

    <footer class="rd-footer">
        <div class="container">RACEDAY &middot; South Africa's running, walking and cycling events hub</div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
